import pygame
import random

# Initialize pygame
pygame.init()

# Screen setup
WIDTH, HEIGHT = 900, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Sheila Mae Sol Ping Pong")

# Colors
MAROON = (90, 0, 20)
BLACK = (0, 0, 0)
WHITE = (255, 255, 255)
NEON = (57, 255, 20)

# Fonts
title_font = pygame.font.SysFont("Arial", 50)
font = pygame.font.SysFont("Arial", 35)

# Clock
clock = pygame.time.Clock()
FPS = 60

# Paddle settings
PADDLE_WIDTH = 15
PADDLE_HEIGHT = 120
PADDLE_SPEED = 8

# Ball settings
BALL_SIZE = 20
ball_speed_x = 5
ball_speed_y = 5
speed_increase = 0.5

# Scores
sheila_score = 0
player2_score = 0
MAX_SCORE = 3

# Paddle positions
left_paddle = pygame.Rect(
    40,
    HEIGHT // 2 - PADDLE_HEIGHT // 2,
    PADDLE_WIDTH,
    PADDLE_HEIGHT
)

right_paddle = pygame.Rect(
    WIDTH - 55,
    HEIGHT // 2 - PADDLE_HEIGHT // 2,
    PADDLE_WIDTH,
    PADDLE_HEIGHT
)

# Ball
ball = pygame.Rect(
    WIDTH // 2,
    HEIGHT // 2,
    BALL_SIZE,
    BALL_SIZE
)

# Game states
game_started = False
game_over = False
winner = ""

# Buttons
start_button = pygame.Rect(WIDTH // 2 - 120, 260, 240, 80)
restart_button = pygame.Rect(WIDTH // 2 - 150, 350, 300, 80)

# Reset ball function
def reset_ball():
    global ball_speed_x, ball_speed_y

    ball.center = (WIDTH // 2, HEIGHT // 2)

    ball_speed_x = random.choice([-5, 5])
    ball_speed_y = random.choice([-5, 5])

# Main loop
running = True

while running:
    clock.tick(FPS)
    screen.fill(MAROON)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.MOUSEBUTTONDOWN:

            if not game_started and start_button.collidepoint(event.pos):
                game_started = True
                game_over = False
                sheila_score = 0
                player2_score = 0
                reset_ball()

            if game_over and restart_button.collidepoint(event.pos):
                game_started = False
                game_over = False
                sheila_score = 0
                player2_score = 0
                reset_ball()

    # START SCREEN
    if not game_started:

        title = title_font.render("SHEILA MAE SOL PING PONG", True, WHITE)
        screen.blit(title, (WIDTH // 2 - title.get_width() // 2, 150))

        pygame.draw.rect(screen, BLACK, start_button, border_radius=20)

        start_text = font.render("START GAME", True, NEON)
        screen.blit(start_text, (
            start_button.x + start_button.width // 2 - start_text.get_width() // 2,
            start_button.y + 20
        ))

        controls = font.render("W/S vs UP/DOWN", True, WHITE)
        screen.blit(controls, (WIDTH // 2 - controls.get_width() // 2, 500))

    # GAME OVER SCREEN
    elif game_over:

        winner_text = title_font.render(winner, True, NEON)
        screen.blit(winner_text, (WIDTH // 2 - winner_text.get_width() // 2, 180))

        score_text = font.render(
            f"Sheila Mae Sol {sheila_score} - {player2_score} Player 2",
            True,
            WHITE
        )

        screen.blit(score_text, (WIDTH // 2 - score_text.get_width() // 2, 260))

        pygame.draw.rect(screen, BLACK, restart_button, border_radius=20)

        restart_text = font.render("START AGAIN", True, NEON)
        screen.blit(restart_text, (
            restart_button.x + restart_button.width // 2 - restart_text.get_width() // 2,
            restart_button.y + 20
        ))

    # GAME SCREEN
    else:

        keys = pygame.key.get_pressed()

        # Player controls
        if keys[pygame.K_w] and left_paddle.top > 0:
            left_paddle.y -= PADDLE_SPEED
        if keys[pygame.K_s] and left_paddle.bottom < HEIGHT:
            left_paddle.y += PADDLE_SPEED

        if keys[pygame.K_UP] and right_paddle.top > 0:
            right_paddle.y -= PADDLE_SPEED
        if keys[pygame.K_DOWN] and right_paddle.bottom < HEIGHT:
            right_paddle.y += PADDLE_SPEED

        # Move ball
        ball.x += int(ball_speed_x)
        ball.y += int(ball_speed_y)

        # Bounce top/bottom
        if ball.top <= 0 or ball.bottom >= HEIGHT:
            ball_speed_y *= -1

        # Paddle collision
        if ball.colliderect(left_paddle) or ball.colliderect(right_paddle):
            ball_speed_x *= -1

            if ball_speed_x > 0:
                ball_speed_x += speed_increase
            else:
                ball_speed_x -= speed_increase

            if ball_speed_y > 0:
                ball_speed_y += speed_increase
            else:
                ball_speed_y -= speed_increase

        # Score
        if ball.left <= 0:
            player2_score += 1
            reset_ball()

        if ball.right >= WIDTH:
            sheila_score += 1
            reset_ball()

        # Winner
        if sheila_score >= MAX_SCORE:
            winner = "SHEILA MAE SOL WINS!"
            game_over = True

        if player2_score >= MAX_SCORE:
            winner = "PLAYER 2 WINS!"
            game_over = True

        # Draw center line
        for i in range(0, HEIGHT, 30):
            pygame.draw.rect(screen, WHITE, (WIDTH // 2 - 2, i, 4, 20))

        # Draw paddles
        pygame.draw.rect(screen, BLACK, left_paddle)
        pygame.draw.rect(screen, BLACK, right_paddle)

        # Ball
        pygame.draw.circle(screen, NEON, ball.center, BALL_SIZE // 2)

        # Scores
        sheila_text = title_font.render(str(sheila_score), True, WHITE)
        player2_text = title_font.render(str(player2_score), True, WHITE)

        screen.blit(sheila_text, (WIDTH // 4, 40))
        screen.blit(player2_text, (WIDTH * 3 // 4, 40))

        # Names
        sheila_name = font.render("Sheila Mae Sol", True, WHITE)
        player2_name = font.render("Player 2", True, WHITE)

        screen.blit(sheila_name, (WIDTH // 4 - 80, 100))
        screen.blit(player2_name, (WIDTH * 3 // 4 - 60, 100))

    pygame.display.update()

pygame.quit()
